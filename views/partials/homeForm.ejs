<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Document</title>
  </head>
  <body>
    <form action="/admin/add-home" method="POST">
      <label for="houseName">Enter house name</label>
      <input type="text" name="houseName" placeholder="Enter house name" />
      <br />
      <label for="pricePerNight">Enter price per night:</label>
      <input type="text" name="pricePerNight" placeholder="Enter price" />
      <br />
      <label for="location">Enter location:</label>
      <input type="text" name="location" placeholder="Enter location" />
      <br />
      <label for="rating">Enter rating:</label>
      <input type="text" name="rating" placeholder="Enter ratings out of 5" />
      <br>
      <input type="submit" />
    </form>
  </body>
</html>
